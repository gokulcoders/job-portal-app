PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/jobproject

# Scraper service (runs on its own port, separate from the API)
SCRAPER_PORT=5001
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_KEYWORDS=node,java,javascript
SCRAPER_CLOSE_AFTER_MINUTES=20

# Redis (OTP storage + rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Geo IP lookup (used to enrich registration with city/region/ISP)
GEO_API_URL=http://ip-api.com/json

# Email (Gmail) — leave blank to log OTPs to the console instead of emailing them.
# EMAIL_PASS must be a Gmail App Password (not your normal password):
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
